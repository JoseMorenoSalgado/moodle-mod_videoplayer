{{!
    This file is part of Moodle - http://moodle.org/

    @template mod_videoplayer/pdfjs

    Protected PDF.js viewer for Drive Resource.
}}
<div class="mod-videoplayer-container mod-videoplayer-pdfjs" data-resource-type="{{type}}" data-cmid="{{cmid}}">
    <div class="mod-videoplayer-meta mb-2">
        <span class="mod-videoplayer-meta-item">{{resourcetype}}</span>
        <span class="mod-videoplayer-meta-item">{{#str}} protectedresource, mod_videoplayer {{/str}}</span>
        {{#completionpercent}}
            <span class="mod-videoplayer-meta-item" data-region="pdfjs-progress">{{completionpercent}}%</span>
        {{/completionpercent}}
    </div>

    {{#totalpages}}
        <div class="mod-videoplayer-resume alert alert-info" data-region="pdfjs-resume">
            {{#str}} resumereading, mod_videoplayer {{/str}}
            <strong>{{initialpage}}</strong> / {{totalpages}}
        </div>
    {{/totalpages}}

    <div class="mod-videoplayer-pdfjs-viewer"
         data-pdf-url="{{pdfurl}}"
         data-title="{{title}}"
         data-cmid="{{cmid}}"
         data-initial-page="{{initialpage}}"
         data-initial-progress="{{initialprogress}}"
         data-initial-time-spent="{{initialtimespent}}"
         data-initial-completion="{{completionpercent}}"
         data-initial-completed="{{#completed}}1{{/completed}}{{^completed}}0{{/completed}}"
         data-display-mode="standard"
         data-disable-context-menu="{{#disablecontextmenu}}1{{/disablecontextmenu}}{{^disablecontextmenu}}0{{/disablecontextmenu}}"
         data-watermark="{{#enablewatermark}}{{watermark}}{{/enablewatermark}}"
         data-search-not-found="{{#str}} searchpdfnotfound, mod_videoplayer {{/str}}"
         data-search-result-page="{{#str}} searchpdfresultpage, mod_videoplayer {{/str}}"
         oncontextmenu="return false;">

        <form class="mod-videoplayer-pdfjs-searchbar" data-region="pdf-search-form" role="search">
            <label class="sr-only visually-hidden" for="mod-videoplayer-pdf-search-{{cmid}}">{{#str}} searchpdf, mod_videoplayer {{/str}}</label>
            <input
                id="mod-videoplayer-pdf-search-{{cmid}}"
                class="form-control mod-videoplayer-pdfjs-search-input"
                type="search"
                data-region="pdf-search-input"
                placeholder="{{#str}} searchpdfplaceholder, mod_videoplayer {{/str}}"
                autocomplete="off">
            <button type="submit" class="btn btn-secondary mod-videoplayer-pdfjs-search-button" data-action="search-pdf">
                {{#str}} searchpdf, mod_videoplayer {{/str}}
            </button>
            <span class="mod-videoplayer-pdfjs-search-status" data-region="pdf-search-status" aria-live="polite"></span>
        </form>

        <div class="mod-videoplayer-pdfjs-canvas-wrap" oncontextmenu="return false;">
            <div class="mod-videoplayer-pdfjs-loading" data-region="pdfjs-loading">
                <span class="mod-videoplayer-pdfjs-spinner" aria-hidden="true"></span>
                <span>{{#str}} loadingpdf, mod_videoplayer {{/str}}</span>
            </div>

            <div class="mod-videoplayer-pdfjs-overlay" aria-label="{{title}}">
                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-prev" data-action="previous-page" title="{{#str}} previouspage, mod_videoplayer {{/str}}" aria-label="{{#str}} previouspage, mod_videoplayer {{/str}}">
                    <span aria-hidden="true">‹</span>
                </button>

                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-zoomout" data-action="zoom-out" title="{{#str}} zoomout, mod_videoplayer {{/str}}" aria-label="{{#str}} zoomout, mod_videoplayer {{/str}}">
                    <span aria-hidden="true">−</span>
                </button>

                <span class="mod-videoplayer-pdfjs-page-status" aria-live="polite">
                    <span data-region="current-page">1</span> / <span data-region="total-pages">-</span>
                    <span class="mod-videoplayer-pdfjs-zoom-status" data-region="zoom-level">100%</span>
                </span>

                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-zoomin" data-action="zoom-in" title="{{#str}} zoomin, mod_videoplayer {{/str}}" aria-label="{{#str}} zoomin, mod_videoplayer {{/str}}">
                    <span aria-hidden="true">+</span>
                </button>

                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-fit" data-action="fit-screen" title="{{#str}} fitscreen, mod_videoplayer {{/str}}" aria-label="{{#str}} fitscreen, mod_videoplayer {{/str}}">
                    <span aria-hidden="true">⤢</span>
                </button>

                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-fullscreen" data-action="fullscreen" title="{{#str}} fullscreen, mod_videoplayer {{/str}}" aria-label="{{#str}} fullscreen, mod_videoplayer {{/str}}">
                    <span aria-hidden="true">⛶</span>
                </button>

                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-next" data-action="next-page" title="{{#str}} nextpage, mod_videoplayer {{/str}}" aria-label="{{#str}} nextpage, mod_videoplayer {{/str}}">
                    <span aria-hidden="true">›</span>
                </button>
            </div>

            <canvas class="mod-videoplayer-pdfjs-canvas" draggable="false" oncontextmenu="return false;"></canvas>
            {{#enablewatermark}}
                <div class="mod-videoplayer-watermark" aria-hidden="true">{{watermark}}</div>
            {{/enablewatermark}}
        </div>

        <div class="mod-videoplayer-pdfjs-error alert alert-danger" data-region="pdfjs-error" hidden>{{#str}} pdfjsrequired, mod_videoplayer {{/str}}</div>
    </div>
</div>
